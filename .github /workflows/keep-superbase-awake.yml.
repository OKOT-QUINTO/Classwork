name: Keep Supabase awake
# Calls the database once a day so the free plan never pauses for inactivity.
on:
  schedule:
    - cron: '17 5 * * *'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Supabase
        env:
          SB_URL: ${{ secrets.SUPABASE_URL || 'https://yppaaekjcdflpkimdznr.supabase.co' }}
          SB_KEY: ${{ secrets.SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlwcGFhZWtqY2RmbHBraW1kem5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIwMjIyMzUsImV4cCI6MjEwNzU5ODIzNX0.o9bmHwxbWqA_7gJ5aCFGrdBrH5Zg0zJ9FBZVMD0IPoY' }}
        run: |
          code=$(curl -s -o /tmp/r.txt -w '%{http_code}' --retry 3 --retry-delay 10 --max-time 30 "$SB_URL/rest/v1/schools?select=id&limit=1" -H "apikey: $SB_KEY" -H "Authorization: Bearer $SB_KEY")
          echo "HTTP $code"; head -c 300 /tmp/r.txt; echo
          case "$code" in 2*) exit 0;; *) exit 1;; esac
